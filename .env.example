# Endereço HTTP do servidor
HTTP_HOST=127.0.0.1
HTTP_PORT=3001

# Conexão MySQL. Sem isso, a API sobe mas os endpoints que dependem de
# persistência retornam erro de configuração (503).
DATABASE_URL=mysql://root:root@127.0.0.1:3306/palpites_back

# Segredo de assinatura dos tokens JWT. Troque em produção.
JWT_SECRET=development-only-secret

# Rodar migrations no boot (default: true). Use 0/false para desligar.
RUN_MIGRATIONS=true

# Armazenamento de arquivos (avatares/escudos). Backend: local (default) ou s3.
# O backend s3 é um stub neste build; use local para o MVP.
FILES_BACKEND=local
FILES_BUCKET=palpites-local
FILES_LOCAL_DIR=./storage
FILES_PUBLIC_BASE_URL=http://127.0.0.1:3001/files-local
FILES_MAX_BYTE_SIZE=5242880
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com

# Jobs em background (scheduler tokio in-process). Use 0/false para desligar.
JOBS_ENABLED=true
# Intervalo entre execuções do job de lembretes de palpite (segundos).
JOBS_REMINDER_INTERVAL_SECONDS=300
# Janela para considerar uma partida "lock se aproximando" (minutos).
JOBS_REMINDER_WINDOW_MINUTES=60
# Período mínimo entre lembretes para o mesmo usuário (minutos): no máximo uma
# notificação de lembrete por usuário nessa janela, mesmo com vários jogos.
JOBS_REMINDER_THROTTLE_MINUTES=60
# Intervalo entre execuções do job de entrega de notificações (segundos).
JOBS_DISPATCH_INTERVAL_SECONDS=60
# Intervalo entre execuções do job que transiciona partidas para "ao vivo" (segundos).
JOBS_LIVE_INTERVAL_SECONDS=60

# Push (Firebase Cloud Messaging). Sem estas duas variáveis o push fica
# dormente: o job de dispatch só registra log e nada é enviado.
# Project ID do projeto Firebase (Project settings > General).
FCM_PROJECT_ID=seu-project-id
# Caminho do JSON da service account (Project settings > Service accounts >
# Generate new private key). Guarde fora do git.
FCM_SERVICE_ACCOUNT_PATH=./secrets/fcm-service-account.json